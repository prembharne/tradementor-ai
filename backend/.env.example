# TradeMentor AI - Production Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME="TradeMentor AI"
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL for production)
DATABASE_URL=postgresql+asyncpg://tradementor:CHANGE_ME@localhost:5432/tradementor

# JWT Authentication
JWT_SECRET_KEY=GENERATE_A_SECURE_RANDOM_KEY_32_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Stellar / Soroban
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
FREIGHTER_APP_ID=tradementor-ai

# Soroban Contract Addresses (set after deployment)
STRATEGY_CONTRACT_ADDRESS=
CHALLENGE_CONTRACT_ADDRESS=
REPUTATION_CONTRACT_ADDRESS=

# AI Services (OpenRouter)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra
VISION_MODEL=nvidia/nemotron-3-ultra

# External APIs (optional)
COINGECKO_API_KEY=
TWELVE_DATA_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=https://tradementor.ai

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
